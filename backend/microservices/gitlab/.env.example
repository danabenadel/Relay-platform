# GitLab Service Configuration
GITLAB_SERVICE_PORT=5013

# GitLab OAuth2 Configuration
GITLAB_CLIENT_ID=your_gitlab_application_id
GITLAB_CLIENT_SECRET=your_gitlab_application_secret
GITLAB_REDIRECT_URI=http://localhost:8081/auth/gitlab/callback

# GitLab Instance URL (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# Backend URL for triggering reactions
BACKEND_URL=http://area_server:8080
