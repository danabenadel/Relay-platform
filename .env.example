# =============================================================================
# RELAY PLATFORM - ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/relay_db

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Port for the backend server (default: 8080)
PORT=8080

# Node environment (development, production, test)
NODE_ENV=development

# API base URL for frontend
API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Encryption key for sensitive data (MUST be exactly 32 characters)
# Generate one with: openssl rand -base64 32 | cut -c1-32
ENCRYPTION_KEY=your-32-character-encryption-key

# -----------------------------------------------------------------------------
# OAUTH - GOOGLE
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback

# -----------------------------------------------------------------------------
# OAUTH - GITHUB
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/auth/oauth/github/callback

# -----------------------------------------------------------------------------
# OAUTH - FACEBOOK
# -----------------------------------------------------------------------------
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:8080/auth/oauth/facebook/callback

# -----------------------------------------------------------------------------
# OAUTH - SPOTIFY
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8080/auth/oauth/spotify/callback

# -----------------------------------------------------------------------------
# OAUTH - NOTION
# -----------------------------------------------------------------------------
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_REDIRECT_URI=http://localhost:8080/auth/oauth/notion/callback

# -----------------------------------------------------------------------------
# OAUTH - GITLAB
# -----------------------------------------------------------------------------
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret
GITLAB_REDIRECT_URI=http://localhost:8080/auth/oauth/gitlab/callback

# -----------------------------------------------------------------------------
# OAUTH - DISCORD
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8080/auth/oauth/discord/callback
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# -----------------------------------------------------------------------------
# OAUTH - REDDIT
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REDIRECT_URI=http://localhost:8080/auth/oauth/reddit/callback

# -----------------------------------------------------------------------------
# OAUTH - ONEDRIVE
# -----------------------------------------------------------------------------
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret
ONEDRIVE_REDIRECT_URI=http://localhost:8080/auth/oauth/onedrive/callback

# -----------------------------------------------------------------------------
# OAUTH - YOUTUBE (uses Google OAuth)
# -----------------------------------------------------------------------------
# YouTube uses the same credentials as Google OAuth above
# Make sure to enable YouTube Data API v3 in your Google Cloud Console

# -----------------------------------------------------------------------------
# TELEGRAM
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# -----------------------------------------------------------------------------
# OPENAI
# -----------------------------------------------------------------------------
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# These are typically only needed for the frontend .env file
# NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
